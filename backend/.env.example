# Copy this file to ".env" and fill in your own values

# MongoDB connection string
# Local Mongo:      mongodb://127.0.0.1:27017/zenbot
# MongoDB Atlas:    mongodb+srv://<user>:<password>@cluster.mongodb.net/zenbot
MONGO_URI=mongodb://127.0.0.1:27017/zenbot

# Any long random string used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_secret

# Port the backend server runs on
PORT=5000

# Comma-separated frontend URLs permitted to call this API in production.
# Leave blank for local development.
CORS_ORIGIN=

# Set to false on a low-memory/free host. Local RAG downloads a ~90MB model
# which is re-downloaded after the host's ephemeral filesystem is cleared.
RAG_ENABLED=true

# ---------------------------------------------------------------
# OPTIONAL: Smarter AI replies
# ---------------------------------------------------------------
# Zenbot works out of the box with NO key at all — it uses a built-in
# empathetic rule-based reply engine so the app is never "broken".
#
# If you want smarter, more natural replies, you can plug in any
# OpenAI-compatible Chat Completions endpoint (OpenAI, Groq, OpenRouter,
# Together AI, a local Ollama server, etc.) by filling these in:

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
